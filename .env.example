# Copy to .env for local development. Dev-only values; never put real secrets here.

# Required. pgx connection string.
DATABASE_URL=postgres://miszacsi:miszacsi@localhost:5432/miszacsi?sslmode=disable

# Listen address. Default: :8080
HTTP_ADDR=:8080

# development or production. Default: production
APP_ENV=development

# Comma-separated allowed origins. Required in production, where * is rejected.
# In development * is allowed.
CORS_ALLOWED_ORIGINS=*

# GraphQL query depth limit. Default: 10
GRAPHQL_MAX_DEPTH=10

# GraphQL query complexity limit. Default: 200
GRAPHQL_MAX_COMPLEXITY=200

# Graceful shutdown drain timeout. Default: 15s
SHUTDOWN_TIMEOUT=15s

# debug, info, warn or error. Default: info
LOG_LEVEL=info
